//------------------------------------------------------------------------------
// [Call Graph Connected Components Export - Subset Analysis]
//------------------------------------------------------------------------------

// Base bipartite edges
.output subset_connected_components.calls_target (compress=true)

// Connected components relation
.output subset_connected_components.call_graph_component (compress=true)

// Component representatives and statistics
.output subset_connected_components.component_representative (compress=true)
.output subset_connected_components.component_size (compress=true)
.output subset_connected_components.component_call_site_count (compress=true)
.output subset_connected_components.component_callee_count (compress=true)
.output subset_connected_components.component_has_unknown_target (compress=true)

// Call site classification
.output subset_connected_components.call_site_fully_resolved (compress=true)
.output subset_connected_components.call_site_partially_unknown (compress=true)
.output subset_connected_components.call_site_fully_unknown (compress=true)
